import os
import queue
import re
import shutil
import subprocess
import tempfile
import threading
import tkinter as tk
from tkinter import filedialog, messagebox, ttk

KEYWORDS = (
    "alignas alignof and asm auto bool break case catch char class concept const "
    "consteval constexpr constinit const_cast continue co_await co_return co_yield "
    "decltype default delete do double dynamic_cast else enum explicit export extern "
    "false float for friend goto if inline int long mutable namespace new noexcept "
    "not nullptr operator or private protected public register reinterpret_cast "
    "requires return short signed sizeof static static_assert static_cast struct "
    "switch template this thread_local throw true try typedef typeid typename union "
    "unsigned using virtual void volatile while"
).split()

STD_TYPES = (
    "string vector map set unordered_map unordered_set list deque array pair tuple "
    "optional variant shared_ptr unique_ptr weak_ptr size_t cout cin cerr endl "
    "ifstream ofstream stringstream thread mutex"
).split()

SAMPLE = r'''#include <iostream>
#include <vector>
#include <string>

int main() {
    std::vector<std::string> names = {"C++", "Python", "Jarvis"};
    for (const auto& n : names) {
        std::cout << "Привет, " << n << "!" << std::endl;
    }

    return 0;
}
'''

BG = "#1e1f22"
FG = "#bcbec4"
COLORS = {
    "keyword": "#cf8e6d",
    "type": "#2aacb8",
    "preproc": "#b3ae60",
    "string": "#6aab73",
    "comment": "#7a7e85",
    "number": "#2aacb8",
    "func": "#56a8f5",
}


class CppIDE:
    def __init__(self, root):
        self.root = root
        self.root.title("C++ IDE — без названия")
        self.root.geometry("1100x760")
        self.filepath = None
        self.proc = None
        self.out_queue = queue.Queue()
        self.tmpdir = tempfile.mkdtemp(prefix="cppide_")
        self.ysb = None

        self._build_menu()
        self._build_ui()
        self._bind_keys()

        self.text.insert("1.0", SAMPLE)
        self.highlight()
        self.update_line_numbers()
        self.root.protocol("WM_DELETE_WINDOW", self.on_close)
        self.root.after(50, self.poll_output)

    # ---------- UI ----------
    def _build_menu(self):
        menubar = tk.Menu(self.root)
        file_menu = tk.Menu(menubar, tearoff=0)
        file_menu.add_command(label="Новый", accelerator="Ctrl+N", command=self.new_file)
        file_menu.add_command(label="Открыть...", accelerator="Ctrl+O", command=self.open_file)
        file_menu.add_command(label="Сохранить", accelerator="Ctrl+S", command=self.save_file)
        file_menu.add_command(label="Сохранить как...", command=self.save_file_as)
        file_menu.add_separator()
        file_menu.add_command(label="Выход", command=self.on_close)
        menubar.add_cascade(label="Файл", menu=file_menu)

        run_menu = tk.Menu(menubar, tearoff=0)
        run_menu.add_command(label="Собрать и запустить", accelerator="F5", command=self.build_and_run)
        run_menu.add_command(label="Только собрать", accelerator="F9", command=lambda: self.build_and_run(run=False))
        run_menu.add_command(label="Остановить", accelerator="Shift+F5", command=self.stop_process)
        menubar.add_cascade(label="Запуск", menu=run_menu)

        self.std_var = tk.StringVar(value="c++20")
        std_menu = tk.Menu(menubar, tearoff=0)
        for s in ("c++11", "c++14", "c++17", "c++20", "c++23"):
            std_menu.add_radiobutton(label=s, variable=self.std_var, value=s)
        menubar.add_cascade(label="Стандарт", menu=std_menu)
        self.root.config(menu=menubar)

    def _build_ui(self):
        toolbar = tk.Frame(self.root, bg="#2b2d30")
        toolbar.pack(fill="x")
        for label, cmd in (("Запуск (F5)", self.build_and_run),
                           ("Сборка (F9)", lambda: self.build_and_run(run=False)),
                           ("■ Стоп", self.stop_process)):
            tk.Button(toolbar, text=label, command=cmd, relief="flat",
                      bg="#3c3f41", fg=FG, activebackground="#4e5254",
                      padx=10).pack(side="left", padx=3, pady=3)

        paned = ttk.PanedWindow(self.root, orient="vertical")
        paned.pack(fill="both", expand=True)

        editor_frame = tk.Frame(paned, bg=BG)
        self.linenums = tk.Canvas(editor_frame, width=50, bg="#2b2d30",
                                  highlightthickness=0)
        self.linenums.pack(side="left", fill="y")
        self.text = tk.Text(editor_frame, bg=BG, fg=FG, insertbackground="white",
                            font=("Consolas", 13), undo=True, wrap="none",
                            selectbackground="#214283", tabs=("4c",), borderwidth=0)
        self.ysb = ttk.Scrollbar(editor_frame, orient="vertical", command=self._yview)
        xsb = ttk.Scrollbar(editor_frame, orient="horizontal", command=self.text.xview)
        self.text.configure(yscrollcommand=self._on_yscroll, xscrollcommand=xsb.set)
        self.ysb.pack(side="right", fill="y")
        xsb.pack(side="bottom", fill="x")
        self.text.pack(side="left", fill="both", expand=True)
        paned.add(editor_frame, weight=3)

        bottom = tk.Frame(paned, bg=BG)
        self.output = tk.Text(bottom, bg="#17181a", fg="#a9b7c6", height=12,
                              font=("Consolas", 11), state="disabled", borderwidth=0)
        self.output.tag_configure("err", foreground="#ff6b68")
        self.output.tag_configure("ok", foreground="#6aab73")
        self.output.tag_configure("info", foreground="#56a8f5")
        osb = ttk.Scrollbar(bottom, command=self.output.yview)
        self.output.configure(yscrollcommand=osb.set)
        input_row = tk.Frame(bottom, bg="#2b2d30")
        input_row.pack(side="bottom", fill="x")
        tk.Label(input_row, text="stdin ›", bg="#2b2d30", fg=FG).pack(side="left", padx=5)
        self.stdin_entry = tk.Entry(input_row, bg="#1e1f22", fg=FG,
                                    insertbackground="white", relief="flat")
        self.stdin_entry.pack(side="left", fill="x", expand=True, pady=3)
        self.stdin_entry.bind("<Return>", self.send_stdin)
        osb.pack(side="right", fill="y")
        self.output.pack(side="left", fill="both", expand=True)
        paned.add(bottom, weight=1)

        for name, color in COLORS.items():
            self.text.tag_configure(name, foreground=color)
        self.text.tag_configure("current_line", background="#26282e")
        self.text.tag_lower("current_line")

        self.status = tk.Label(self.root, text="Строка 1, столбец 1", anchor="w",
                               bg="#2b2d30", fg=FG)
        self.status.pack(fill="x")

    def _bind_keys(self):
        t = self.text
        t.bind("<<Modified>>", self._on_modified)
        t.bind("<KeyRelease>", self._on_cursor)
        t.bind("<ButtonRelease-1>", self._on_cursor)
        t.bind("<Return>", self.auto_indent)
        t.bind("<Tab>", self.insert_tab)
        t.bind("<Control-slash>", self.toggle_comment)
        t.bind("<Configure>", lambda e: self.update_line_numbers())
        for seq, cmd in (("<Control-s>", self.save_file), ("<Control-o>", self.open_file),
                         ("<Control-n>", self.new_file)):
            self.root.bind(seq, lambda e, c=cmd: (c(), "break")[1])
        self.root.bind("<F5>", lambda e: self.build_and_run())
        self.root.bind("<F9>", lambda e: self.build_and_run(run=False))
        self.root.bind("<Shift-F5>", lambda e: self.stop_process())

    def _yview(self, *args):
        self.text.yview(*args)
        self.update_line_numbers()

    def _on_yscroll(self, first, last):
        if self.ysb is not None:
            self.ysb.set(first, last)
        self.update_line_numbers()

    def update_line_numbers(self):
        self.linenums.delete("all")
        i = self.text.index("@0,0")
        while True:
            dline = self.text.dlineinfo(i)
            if dline is None:
                break
            y = dline[1]
            num = str(i).split(".")[0]
            self.linenums.create_text(44, y, anchor="ne", text=num,
                                      fill="#6f737a", font=("Consolas", 12))
            i = self.text.index(f"{i}+1line")

    def _on_modified(self, event=None):
        if self.text.edit_modified():
            self.highlight()
            self.update_line_numbers()
            self._on_cursor()
            self.text.edit_modified(False)

    def _on_cursor(self, event=None):
        line, col = self.text.index("insert").split(".")
        self.status.config(text=f"Строка {line}, столбец {int(col) + 1}")
        self.text.tag_remove("current_line", "1.0", "end")
        self.text.tag_add("current_line", f"{line}.0", f"{line}.0 lineend+1c")

    def highlight(self):
        content = self.text.get("1.0", "end-1c")
        for tag in COLORS:
            self.text.tag_remove(tag, "1.0", "end")

        def apply(pattern, tag, flags=0, group=0):
            for m in re.finditer(pattern, content, flags):
                s, e = m.start(group), m.end(group)
                self.text.tag_add(tag, f"1.0+{s}c", f"1.0+{e}c")

        apply(r"\b\d+(\.\d+)?([eE][+-]?\d+)?[fFuUlL]*\b", "number")
        apply(r"\b(" + "|".join(STD_TYPES) + r")\b", "type")
        # func ДО keyword, чтобы ключевые слова перекрывали "func"
        apply(r"\b([A-Za-z_]\w*)\s*(?=\()", "func")
        apply(r"\b(" + "|".join(KEYWORDS) + r")\b", "keyword")
        apply(r"^\s*#\s*\w+", "preproc", re.M)
        apply(r"<[\w./]+>", "string", 0)  # include <...>
        apply(r'"(\\.|[^"\\\n])*"', "string")
        apply(r"'(\\.|[^'\\\n])*'", "string")
        apply(r"//[^\n]*", "comment")
        apply(r"/\*.*?\*/", "comment", re.S)

    def auto_indent(self, event):
        line = self.text.get("insert linestart", "insert")
        indent = re.match(r"\s*", line).group(0)
        if line.rstrip().endswith("{"):
            indent += "    "
        self.text.insert("insert", "\n" + indent)
        self.text.see("insert")
        return "break"

    def insert_tab(self, event):
        self.text.insert("insert", "    ")
        return "break"

    def toggle_comment(self, event=None):
        try:
            start = int(self.text.index("sel.first").split(".")[0])
            end = int(self.text.index("sel.last").split(".")[0])
        except tk.TclError:
            start = end = int(self.text.index("insert").split(".")[0])
        lines = [self.text.get(f"{n}.0", f"{n}.end") for n in range(start, end + 1)]
        uncomment = all(l.lstrip().startswith("//") for l in lines if l.strip())
        for n, l in zip(range(start, end + 1), lines):
            if uncomment:
                new = re.sub(r"//\s?", "", l, count=1)
            else:
                new = "// " + l
            self.text.delete(f"{n}.0", f"{n}.end")
            self.text.insert(f"{n}.0", new)
        return "break"

    def _set_title(self):
        name = os.path.basename(self.filepath) if self.filepath else "без названия"
        self.root.title(f"C++ IDE — {name}")

    def new_file(self):
        self.text.delete("1.0", "end")
        self.filepath = None
        self._set_title()

    def open_file(self):
        path = filedialog.askopenfilename(
            filetypes=[("C++", "*.cpp *.cc *.cxx *.h *.hpp"), ("Все файлы", "*.*")])
        if not path:
            return
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            data = f.read()
        self.text.delete("1.0", "end")
        self.text.insert("1.0", data)
        self.filepath = path
        self._set_title()

    def save_file(self):
        if not self.filepath:
            return self.save_file_as()
        with open(self.filepath, "w", encoding="utf-8") as f:
            f.write(self.text.get("1.0", "end-1c"))
        self.log(f"Сохранено: {self.filepath}\n", "info")

    def save_file_as(self):
        path = filedialog.asksaveasfilename(
            defaultextension=".cpp",
            filetypes=[("C++", "*.cpp"), ("Заголовок", "*.h *.hpp"), ("Все файлы", "*.*")])
        if not path:
            return
        self.filepath = path
        self._set_title()
        self.save_file()

    def log(self, msg, tag=None):
        self.output.configure(state="normal")
        self.output.insert("end", msg, tag)
        self.output.see("end")
        self.output.configure(state="disabled")

    def clear_output(self):
        self.output.configure(state="normal")
        self.output.delete("1.0", "end")
        self.output.configure(state="disabled")

    def find_compiler(self):
        for name in ("g++", "clang++", "c++"):
            path = shutil.which(name)
            if path:
                return path
        return None

    def build_and_run(self, run=True):
        if self.proc and self.proc.poll() is None:
            self.stop_process()
        compiler = self.find_compiler()
        self.clear_output()
        if not compiler:
            self.log("Компилятор не найден. Установите g++ или clang++ "
                     "(MinGW/MSYS2 для Windows, build-essential для Linux).\n", "err")
            return
        src = os.path.join(self.tmpdir, "main.cpp")
        with open(src, "w", encoding="utf-8") as f:
            f.write(self.text.get("1.0", "end-1c"))
        exe = os.path.join(self.tmpdir, "main.exe" if os.name == "nt" else "main")
        cmd = [compiler, f"-std={self.std_var.get()}", "-Wall", "-Wextra", src, "-o", exe]
        self.log("$ " + " ".join(cmd) + "\n", "info")
        threading.Thread(target=self._compile_thread, args=(cmd, exe, run), daemon=True).start()

    def _compile_thread(self, cmd, exe, run):
        try:
            res = subprocess.run(cmd, capture_output=True, text=True,
                                 encoding="utf-8", errors="replace")
        except Exception as e:
            self.out_queue.put(("err", f"Ошибка запуска компилятора: {e}\n"))
            return
        if res.stderr:
            self.out_queue.put(("err" if res.returncode else None, res.stderr))
        if res.returncode != 0:
            self.out_queue.put(("err", "\nСборка не удалась.\n"))
            return
        self.out_queue.put(("ok", "Сборка успешна.\n"))
        if run:
            self.out_queue.put(("start", exe))

    def _start_process(self, exe):
        self.log("--- запуск ---\n", "info")
        try:
            self.proc = subprocess.Popen([exe], stdin=subprocess.PIPE,
                                         stdout=subprocess.PIPE,
                                         stderr=subprocess.STDOUT, bufsize=-1)
        except Exception as e:
            self.log(f"Не удалось запустить: {e}\n", "err")
            return
        threading.Thread(target=self._reader_thread, args=(self.proc,), daemon=True).start()

    def _reader_thread(self, proc):
        while True:
            chunk = proc.stdout.read(1024)
            if not chunk:
                break
            self.out_queue.put((None, chunk.decode("utf-8", errors="replace")))
        code = proc.wait()
        self.out_queue.put(("info", f"\n--- процесс завершён с кодом {code} ---\n"))

    def poll_output(self):
        try:
            while True:
                tag, data = self.out_queue.get_nowait()
                if tag == "start":
                    self._start_process(data)
                else:
                    self.log(data, tag)
        except queue.Empty:
            pass
        self.root.after(50, self.poll_output)

    def send_stdin(self, event=None):
        line = self.stdin_entry.get()
        self.stdin_entry.delete(0, "end")
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.stdin.write((line + "\n").encode("utf-8"))
                self.proc.stdin.flush()
                self.log(line + "\n", "info")
            except OSError:
                pass

    def stop_process(self):
        if self.proc and self.proc.poll() is None:
            self.proc.kill()

    def on_close(self):
        self.stop_process()
        shutil.rmtree(self.tmpdir, ignore_errors=True)
        self.root.destroy()


if __name__ == "__main__":
    root = tk.Tk()
    CppIDE(root)
    root.mainloop()
