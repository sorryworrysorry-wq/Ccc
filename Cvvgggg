    # ---------- строка состояния ----------
    def _update_status(self):
        try:
            line, col = self.text.index("insert").split(".")
            col = int(col) + 1
        except Exception:
            line, col = "1", 1
        mark = "●" if self.modified else "○"
        name = os.path.basename(self.filepath) if self.filepath else "без названия"
        self.status.config(
            text=f"{mark}  {name}   |   Стр {line}:{col}   |   {self.std_var.get()}   |   UTF-8"
        )

    def _set_title(self):
        name = os.path.basename(self.filepath) if self.filepath else "без названия"
        star = " ●" if self.modified else ""
        self.root.title(f"C++ IDE — {name}{star}")
        self._update_status()

    def _on_yscroll(self, first, last):
        if self.ysb is not None:
            self.ysb.set(first, last)
        self.update_line_numbers()
        self.update_minimap()

    def update_line_numbers(self):
        self.linenums.delete("all")
        i = self.text.index("@0,0")
        cur = self.text.index("insert").split(".")[0]
        while True:
            dline = self.text.dlineinfo(i)
            if dline is None:
                break
            y = dline[1]
            num = str(i).split(".")[0]
            # маркер folding
            line_text = self.text.get(f"{num}.0", f"{num}.end")
            if "{" in line_text or "}" in line_text:
                fold_char = "▸" if self._has_fold(int(num)) else "▾"
                self.linenums.create_text(6, y, anchor="nw", text=fold_char,
                                          fill="#6f737a", font=self._folding_font,
                                          tags=(f"fold:{num}",))
                self.linenums.tag_bind(f"fold:{num}", "<Button-1>",
                                       lambda e, n=int(num): self._toggle_fold(n))
            fill = "#d7d7d7" if num == cur else "#6f737a"
            self.linenums.create_text(46, y, anchor="ne", text=num,
                                      fill=fill, font=(FONT_NAME, 12))
            i = self.text.index(f"{i}+1line")

    def _has_fold(self, line_no):
        return line_no in self.folded

    def _toggle_fold(self, line_no):
        # простая реализация: скрыть/показать блокируем через elide
        try:
            start = f"{line_no}.0"
            depth = 0
            i = start
            opened = False
            end = None
            while True:
                chunk = self.text.get(i, f"{i}+1c")
                if not chunk:
                    break
                if chunk == "{":
                    depth += 1
                    opened = True
                elif chunk == "}":
                    depth -= 1
                    if opened and depth == 0:
                        end = i
                        break
                i = self.text.index(f"{i}+1c")
            if not end:
                return
            end_line = int(end.split(".")[0])
            if line_no in self.folded:
                self.text.tag_remove("elide", f"{line_no + 1}.0", f"{end_line}.end")
                self.folded.discard(line_no)
            else:
                self.text.tag_add("elide", f"{line_no + 1}.0", f"{end_line}.end")
                self.text.tag_configure("elide", elide=True)
                self.folded.add(line_no)
            self.update_line_numbers()
        except Exception:
            pass

    def update_minimap(self):
        self.minimap.delete("all")
        try:
            total = int(self.text.index("end-1c").split(".")[0])
            if total == 0:
                return
            h = max(self.minimap.winfo_height(), 1)
            step = max(1, total // h)
            content = self.text.get("1.0", "end-1c").splitlines()
            for y in range(0, h, 2):
                idx = (y * total) // h
                if idx >= len(content):
                    break
                line = content[idx]
                indent = len(line) - len(line.lstrip())
                length = min(len(line.strip()), 70)
                if length == 0:
                    continue
                color = "#3a3d42"
                if re.search(r"\b(if|for|while|return|class|struct|void|int)\b", line):
                    color = "#5a5d62"
                self.minimap.create_line(indent, y, indent + length, y, fill=color)
            # вьюпорт
            first = float(self.text.index("@0,0").split(".")[0]) / total
            last = float(self.text.index(f"@0,{self.text.winfo_height()}").split(".")[0]) / total
            self.minimap.create_rectangle(0, first * h, 90, last * h,
                                          outline="#56a8f5", width=1)
        except Exception:
            pass

    def _minimap_click(self, event):
        total = int(self.text.index("end-1c").split(".")[0])
        h = max(self.minimap.winfo_height(), 1)
        ratio = event.y / h
        line = max(1, int(total * ratio))
        self.text.see(f"{line}.0")

    # ---------- модификация / подсветка ----------
    def _on_modified(self, event=None):
        if not self.text.edit_modified():
            return
        self.modified = True
        self._set_title()
        if self.hl_job:
            self.root.after_cancel(self.hl_job)
        self.hl_job = self.root.after(120, self._do_highlight)
        self.text.edit_modified(False)

    def _do_highlight(self):
        self.highlight()
        self.update_line_numbers()
        self.update_minimap()
        self._on_cursor()

    def _on_cursor(self, event=None):
        try:
            line, col = self.text.index("insert").split(".")
        except Exception:
            return
        self._update_status()
        self.text.tag_remove("current_line", "1.0", "end")
        self.text.tag_add("current_line", f"{line}.0", f"{line}.0 lineend+1c")
        self._highlight_matching_paren()

    def _highlight_matching_paren(self):
        self.text.tag_remove("paren", "1.0", "end")
        try:
            idx = self.text.index("insert")
        except Exception:
            return
        before = self.text.get(f"{idx}-1c", idx)
        after = self.text.get(idx, f"{idx}+1c")
        ch = before if before in "(){}[]" else (after if after in "(){}[]" else None)
        if not ch:
            return
        pos = self.text.index(f"{idx}-1c") if before in "(){}[]" else idx
        pair = {"(": ")", ")": "(", "{": "}", "}": "{", "[": "]", "]": "["}[ch]
        direction = "next" if ch in "({[" else "prev"
        depth = 0
        cur = pos
        while True:
            nxt = self.text.index(f"{cur} {direction}chars")
            if nxt == cur:
                break
            c = self.text.get(nxt, f"{nxt}+1c")
            if c == ch:
                depth += 1
            elif c == pair:
                if depth == 0:
                    self.text.tag_add("paren", pos, f"{pos}+1c")
                    self.text.tag_add("paren", nxt, f"{nxt}+1c")
                    return
                depth -= 1
            cur = nxt

    def highlight(self):
        content = self.text.get("1.0", "end-1c")
        for tag in COLORS:
            self.text.tag_remove(tag, "1.0", "end")
        self.text.tag_remove("paren", "1.0", "end")

        def apply(pattern, tag, flags=0, group=0):
            for m in re.finditer(pattern, content, flags):
                s, e = m.start(group), m.end(group)
                if s == e:
                    continue
                self.text.tag_add(tag, f"1.0+{s}c", f"1.0+{e}c")

        apply(r"\b\d+(\.\d+)?([eE][+-]?\d+)?[fFuUlL]*\b", "number")
        apply(r"\b(" + "|".join(STD_TYPES) + r")\b", "type")
        apply(r"\b([A-Za-z_]\w*)\s*(?=\()", "func")
        apply(r"\b(" + "|".join(KEYWORDS) + r")\b", "keyword")
        apply(r"^\s*#\s*\w+", "preproc", re.M)
        apply(r"<[\w./+]+>", "string")
        apply(r'"(\\.|[^"\\\n])*"', "string")
        apply(r"'(\\.|[^'\\\n])*'", "string")
        apply(r"//[^\n]*", "comment")
        apply(r"/\*.*?\*/", "comment", re.S)

        for tag in TAG_PRIORITY:
            self.text.tag_raise(tag)

    # ---------- редактирование ----------
    def auto_indent(self, event):
        try:
            line = self.text.get("insert linestart", "insert")
            indent = re.match(r"\s*", line).group(0)
            stripped = line.rstrip()
            extra = ""
            if stripped.endswith("{"):
                extra = "    "
            elif stripped.endswith(("(", "[")):
                extra = "    "
            self.text.insert("insert", "\n" + indent + extra)
            self.text.see("insert")
            return "break"
        except Exception:
            return None

    def insert_tab(self, event):
        try:
            self.text.index("sel.first")
            # есть выделение → сдвиг блока
            start = int(self.text.index("sel.first").split(".")[0])
            end = int(self.text.index("sel.last").split(".")[0])
            for n in range(start, end + 1):
                self.text.insert(f"{n}.0", "    ")
        except tk.TclError:
            self.text.insert("insert", "    ")
        return "break"

    def smart_backspace(self, event):
        # удалить парную скобку/кавычку, если между ними ничего
        try:
            idx = self.text.index("insert")
            before = self.text.get(f"{idx}-1c", idx)
            after = self.text.get(idx, f"{idx}+1c")
            pairs = {"(": ")", "[": "]", "{": "}", '"': '"', "'": "'"}
            if before in pairs and after == pairs[before]:
                self.text.delete(idx, f"{idx}+1c")
                return "break"
            # удалить блок из 4 пробелов
            line_start = self.text.index("insert linestart")
            line_prefix = self.text.get(line_start, idx)
            if line_prefix and line_prefix.strip() == "" and len(line_prefix) % 4 == 0:
                self.text.delete(f"{idx}-4c", idx)
                return "break"
        except Exception:
            pass
        return None

    def _auto_pair(self, open_ch, close_ch):
        try:
            try:
                self.text.index("sel.first")
                return None  # не мешаем выделению
            except tk.TclError:
                pass
            self.text.insert("insert", open_ch + close_ch)
            self.text.mark_set("insert", "insert-1c")
            return "break"
        except Exception:
            return None

    def toggle_comment(self, event=None):
        try:
            start = int(self.text.index("sel.first").split(".")[0])
            end = int(self.text.index("sel.last").split(".")[0])
        except tk.TclError:
            start = end = int(self.text.index("insert").split(".")[0])
        lines = [self.text.get(f"{n}.0", f"{n}.end") for n in range(start, end + 1)]
        non_empty = [l for l in lines if l.strip()]
        uncomment = bool(non_empty) and all(l.lstrip().startswith("//") for l in non_empty)
        for n, l in zip(range(start, end + 1), lines):
            m = re.match(r"(\s*)//\s?", l)
            if uncomment and m:
                new = m.group(1) + l[m.end():]
            elif not uncomment:
                new = "// " + l
            else:
                new = l
            self.text.delete(f"{n}.0", f"{n}.end")
            self.text.insert(f"{n}.0", new)
        return "break"

    def duplicate_line(self, event=None):
        try:
            line = self.text.index("insert").split(".")[0]
            content = self.text.get(f"{line}.0", f"{line}.end")
            self.text.insert(f"{line}.end", "\n" + content)
            self.text.mark_set("insert", f"{int(line) + 1}.0")
            self.text.see("insert")
        except Exception:
            pass
        return "break"

    def delete_line(self, event=None):
        try:
            line = self.text.index("insert").split(".")[0]
            self.text.delete(f"{line}.0", f"{line}.end+1c")
        except Exception:
            pass
        return "break"

    def move_line(self, delta):
        try:
            line = int(self.text.index("insert").split(".")[0])
            if delta < 0 and line == 1:
                return
            total = int(self.text.index("end-1c").split(".")[0])
            if delta > 0 and line == total:
                return
            target = line + delta
            cur = self.text.get(f"{line}.0", f"{line}.end")
            other = self.text.get(f"{target}.0", f"{target}.end")
            self.text.delete(f"{line}.0", f"{line}.end")
            self.text.insert(f"{line}.0", other)
            self.text.delete(f"{target}.0", f"{target}.end")
            self.text.insert(f"{target}.0", cur)
            self.text.mark_set("insert", f"{target}.0")
        except Exception:
            pass

    def zoom(self, direction):
        if direction == 0:
            self.font_size = 13
        else:
            self.font_size = max(8, min(32, self.font_size + direction))
        self.text.configure(font=(FONT_NAME, self.font_size))
        self.update_line_numbers()

    # ---------- поиск / замена ----------
    def show_search(self):
        if self.search_win and self.search_win.winfo_exists():
            self.search_win.lift()
            return
        win = tk.Toplevel(self.root)
        win.title("Найти и заменить")
        win.configure(bg=BG)
        win.transient(self.root)
        win.geometry("400x150")
        self.search_win = win

        frame = tk.Frame(win, bg=BG)
        frame.pack(fill="both", expand=True, padx=8, pady=8)
        tk.Label(frame, text="Найти:", bg=BG, fg=FG).grid(row=0, column=0, sticky="w")
        self.find_var = tk.StringVar()
        find_entry = tk.Entry(frame, textvariable=self.find_var, bg="#2b2d30", fg=FG,
                              insertbackground="white")
        find_entry.grid(row=0, column=1, sticky="ew", padx=4, pady=2)
        tk.Label(frame, text="Заменить:", bg=BG, fg=FG).grid(row=1, column=0, sticky="w")
        self.replace_var = tk.StringVar()
        tk.Entry(frame, textvariable=self.replace_var, bg="#2b2d30", fg=FG,
                 insertbackground="white").grid(row=1, column=1, sticky="ew", padx=4, pady=2)
        frame.columnconfigure(1, weight=1)

        btns = tk.Frame(frame, bg=BG)
        btns.grid(row=2, column=0, columnspan=2, sticky="ew", pady=6)
        for text, cmd in (("Найти далее", self.find_next),
                          ("Заменить", self.replace_one),
                          ("Заменить всё", self.replace_all)):
            tk.Button(btns, text=text, command=cmd, bg="#3c3f41", fg=FG,
                      relief="flat").pack(side="left", padx=2)
        self.find_var.trace_add("write", lambda *a: self._highlight_matches())
        find_entry.focus_set()
        self._find_entry = find_entry

    def _close_search(self, event=None):
        if self.search_win and self.search_win.winfo_exists():
            self.search_win.destroy()
        self.text.tag_remove("search_all", "1.0", "end")
        self.text.tag_remove("search_cur", "1.0", "end")

    def _highlight_matches(self):
        self.text.tag_remove("search_all", "1.0", "end")
        self.text.tag_remove("search_cur", "1.0", "end")
        needle = self.find_var.get()
        if not needle:
            return
        start = "1.0"
        while True:
            pos = self.text.search(needle, start, stopindex="end", nocase=True)
            if not pos:
                break
            end = f"{pos}+{len(needle)}c"
            self.text.tag_add("search_all", pos, end)
            start = end

    def find_next(self):
        needle = self.find_var.get()
        if not needle:
            return
        try:
            sel_end = self.text.index("sel.last")
        except tk.TclError:
            sel_end = self.text.index("insert")
        pos = self.text.search(needle, sel_end, stopindex="end", nocase=True)
        if not pos:
            pos = self.text.search(needle, "1.0", stopindex="end", nocase=True)
        if not pos:
            return
        end = f"{pos}+{len(needle)}c"
        self.text.tag_remove("search_cur", "1.0", "end")
        self.text.tag_add("search_cur", pos, end)
        self.text.mark_set("insert", end)
        self.text.see(pos)

    def replace_one(self):
        needle = self.find_var.get()
        if not needle:
            return
        try:
            sel_start = self.text.index("sel.first")
            sel_end = self.text.index("sel.last")
            if self.text.get(sel_start, sel_end) == needle:
                self.text.delete(sel_start, sel_end)
                self.text.insert(sel_start, self.replace_var.get())
        except tk.TclError:
            pass
        self.find_next()

    def replace_all(self):
        needle = self.find_var.get()
        if not needle:
            return
        content = self.text.get("1.0", "end-1c")
        new, n = re.subn(re.escape(needle), self.replace_var.get(), content, flags=re.IGNORECASE)
        if n:
            self.text.delete("1.0", "end")
            self.text.insert("1.0", new)
            self.log(f"Заменено вхождений: {n}\n", "info")

    def goto_line(self):
        n = simpledialog.askinteger("Перейти", "Номер строки:", parent=self.root, minvalue=1)
        if n:
            self.text.mark_set("insert", f"{n}.0")
            self.text.see(f"{n}.0")
            self._on_cursor()

    # ---------- работа с файлами ----------
    def _confirm_discard(self):
        if not self.modified:
            return True
        ans = messagebox.askyesnocancel("Не сохранено",
                                        "Сохранить изменения перед продолжением?")
        if ans is None:
            return False
        if ans:
            return self.save_file() is not False
        return True

    def new_file(self):
        if not self._confirm_discard():
            return
        self.text.delete("1.0", "end")
        self.filepath = None
        self.modified = False
        self._set_title()

    def open_file(self, path=None):
        if not self._confirm_discard():
            return
        if path is None:
            path = filedialog.askopenfilename(
                filetypes=[("C++", "*.cpp *.cc *.cxx *.h *.hpp"),
                           ("Все файлы", "*.*")])
        if not path:
            return
        try:
            with open(path, "r", encoding="utf-8", errors="replace", newline="") as f:
                data = f.read()
        except OSError as e:
            messagebox.showerror("Ошибка", str(e))
            return
        self.text.delete("1.0", "end")
        self.text.insert("1.0", data)
        self.filepath = path
        self.modified = False
        self._set_title()
        self._do_highlight()

    def save_file(self):
        if not self.filepath:
            return self.save_file_as()
        try:
            with open(self.filepath, "w", encoding="utf-8", newline="") as f:
                f.write(self.text.get("1.0", "end-1c"))
            self.modified = False
            self._set_title()
            self.log(f"Сохранено: {self.filepath}\n", "info")
            return True
        except OSError as e:
            messagebox.showerror("Ошибка", str(e))
            return False

    def save_file_as(self):
        path = filedialog.asksaveasfilename(
            defaultextension=".cpp",
            filetypes=[("C++", "*.cpp"), ("Заголовок", "*.h *.hpp"), ("Все файлы", "*.*")])
        if not path:
            return False
        self.filepath = path
        return self.save_file()

    def export_output(self):
        path = filedialog.asksaveasfilename(defaultextension=".log",
                                            filetypes=[("Log", "*.log"), ("Все файлы", "*.*")])
        if not path:
            return
        try:
            with open(path, "w", encoding="utf-8") as f:
                f.write(self.output.get("1.0", "end-1c"))
        except OSError as e:
            messagebox.showerror("Ошибка", str(e))

    def _schedule_autosave(self):
        if self.filepath and self.modified:
            self.save_file()
        self.autosave_job = self.root.after(30_000, self._schedule_autosave)

    # ---------- drag & drop ----------
    def _enable_dnd(self):
        try:
            self.root.tk.call("package", "require", "tkdnd")
            self.text.drop_target_register("DND_Files")
            self.text.dnd_bind("<<Drop>>", self._on_drop)
        except tk.TclError:
            pass  # tkdnd не установлен — пропускаем

    def _on_drop(self, event):
        path = event.data.strip()
        if path.startswith("{") and path.endswith("}"):
            path = path[1:-1]
        self.open_file(path)

    # ---------- компиляция и запуск ----------
    def log(self, msg, tag=None):
        self.output.configure(state="normal")
        if tag == "err":
            # кликабельные локации file:line:col
            for m in re.finditer(r"([^\s:]+):(\d+):(\d+)", msg):
                pass  # пока просто выводим
        self.output.insert("end", msg, tag)
        self.output.see("end")
        self.output.configure(state="disabled")

    def clear_output(self):
        self.output.configure(state="normal")
        self.output.delete("1.0", "end")
        self.output.configure(state="disabled")

    def find_compiler(self):
        for name in ("g++", "clang++", "c++"):
            p = shutil.which(name)
            if p:
                return p
        return None

    def _check_balance(self):
        content = self.text.get("1.0", "end-1c")
        # убираем строки и комментарии
        content = re.sub(r'"(\\.[^"\\]|\\.|[^"\\])*"', "", content)
        content = re.sub(r"'(\\.|[^'\\])*'", "", content)
        content = re.sub(r"//[^\n]*", "", content)
        content = re.sub(r"/\*.*?\*/", "", content, flags=re.S)
        pairs = {"(": ")", "[": "]", "{": "}"}
        stack = []
        line = 1
        col = 0
        for ch in content:
            if ch == "\n":
                line += 1
                col = 0
            col += 1
            if ch in pairs:
                stack.append((ch, line, col))
            elif ch in pairs.values():
                if not stack or pairs[stack[-1][0]] != ch:
                    return f"Лишняя закрывающая '{ch}' в {line}:{col}"
                stack.pop()
        if stack:
            ch, ln, cl = stack[-1]
            return f"Не закрыта '{ch}' открытая в {ln}:{cl}"
        return None

    def build_and_run(self, run=True):
        if self.proc and self.proc.poll() is None:
            self.stop_process()
        self.clear_output()
        err = self._check_balance()
        if err:
            self.log(f"❌ {err}\n", "err")
            if not messagebox.askyesno("Скобки", f"{err}\nСобрать всё равно?"):
                return
        compiler = self.find_compiler()
        if not compiler:
            self.log("❌ Компилятор не найден (g++/clang++/c++).\n", "err")
            return
        src = os.path.join(self.tmpdir, "main.cpp")
        with open(src, "w", encoding="utf-8", newline="") as f:
            f.write(self.text.get("1.0", "end-1c"))
        exe = os.path.join(self.tmpdir, "main.exe" if os.name == "nt" else "main")
        cmd = [compiler, f"-std={self.std_var.get()}", "-Wall", "-Wextra",
               "-O2", src, "-o", exe]
        self.log("$ " + " ".join(cmd) + "\n", "info")
        self.build_start = time.monotonic()
        threading.Thread(target=self._compile_thread, args=(cmd, exe, run),
                         daemon=True).start()

    def _compile_thread(self, cmd, exe, run):
        try:
            res = subprocess.run(cmd, capture_output=True, text=True,
                                 encoding="utf-8", errors="replace")
        except Exception as e:
            self.out_queue.put(("err", f"Ошибка компилятора: {e}\n"))
            return
        elapsed = time.monotonic() - self.build_start
        if res.stderr:
            self.out_queue.put(("err" if res.returncode else None, res.stderr))
        if res.returncode != 0:
            self.out_queue.put(("err", f"\n❌ Сборка не удалась ({elapsed:.2f} с).\n"))
            return
        self.out_queue.put(("ok", f"✅ Сборка успешна за {elapsed:.2f} с.\n"))
        if run:
            self.out_queue.put(("start", exe))

    def _start_process(self, exe):
        self.log("── запуск ──\n", "info")
        self.run_start = time.monotonic()
        try:
            kwargs = dict(stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                          stderr=subprocess.STDOUT, bufsize=1, text=True,
                          encoding="utf-8", errors="replace")
            if os.name == "nt":
                kwargs["creationflags"] = subprocess.CREATE_NEW_PROCESS_GROUP
            else:
                kwargs["start_new_session"] = True
            self.proc = subprocess.Popen([exe], **kwargs)
        except Exception as e:
            self.log(f"Не удалось запустить: {e}\n", "err")
            return
        threading.Thread(target=self._reader_thread, args=(self.proc,),
                         daemon=True).start()

    def _reader_thread(self, proc):
        try:
            for line in iter(proc.stdout.readline, ""):
                self.out_queue.put((None, line))
        except Exception:
            pass
        finally:
            code = proc.wait()
            elapsed = time.monotonic() - self.run_start
            self.out_queue.put(("timing",
                                f"\n── процесс завершён (код {code}, {elapsed:.2f} с) ──\n"))

    def poll_output(self):
        try:
            while True:
                tag, data = self.out_queue.get_nowait()
                if tag == "start":
                    self._start_process(data)
                else:
                    self.log(data, tag if tag != "timing" else "timing")
        except queue.Empty:
            pass
        self.root.after(50, self.poll_output)

    def send_stdin(self, event=None):
        line = self.stdin_entry.get()
        self.stdin_entry.delete(0, "end")
        if self.proc and self.proc.poll() is None:
            try:
                self.proc.stdin.write(line + "\n")
                self.proc.stdin.flush()
                self.log(line + "\n", "info")
            except OSError:
                pass

    def stop_process(self):
        if self.proc and self.proc.poll() is None:
            try:
                if os.name == "nt":
                    subprocess.run(["taskkill", "/F", "/T", "/PID", str(self.proc.pid)],
                                   capture_output=True)
                else:
                    import signal
                    os.killpg(os.getpgid(self.proc.pid), signal.SIGKILL)
            except Exception:
                try:
                    self.proc.kill()
                except Exception:
                    pass
            self.log("⏹ Остановлено.\n", "err")

    def _click_output(self, event):
        idx = self.output.index(f"@{event.x},{event.y}")
        line = self.output.get(f"{idx} linestart", f"{idx} lineend")
        m = re.search(r"([^\s:]+):(\d+):(\d+)", line)
        if m and ("error" in line or "warning" in line or "ошибка" in line.lower()):
            self._jump(m.group(2), m.group(3))

    def _jump_to_error(self, event=None):
        pass

    def _jump(self, line, col):
        try:
            self.text.mark_set("insert", f"{line}.{int(col) - 1}")
            self.text.see(f"{line}.0")
            self._on_cursor()
            self.text.focus_set()
        except Exception:
            pass

    # ---------- завершение ----------
    def on_close(self):
        if not self._confirm_discard():
            return
        self.stop_process()
        if self.autosave_job:
            self.root.after_cancel(self.autosave_job)
        shutil.rmtree(self.tmpdir, ignore_errors=True)
        self.root.destroy()


def main():
    root = tk.Tk()
    try:
        style = ttk.Style()
        style.theme_use("clam")
    except tk.TclError:
        pass
    CppIDE(root)
    root.mainloop()


if __name__ == "__main__":
    main()
